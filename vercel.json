{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "baratoya.vercel.app"
        }
      ],
      "destination": "https://baratoya.app/:path*",
      "permanent": true
    }
  ],
  "crons": [
    {
      "path": "/api/cron/precios",
      "schedule": "0 10 * * *"
    }
  ]
}
